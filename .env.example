# MySQL Database Configuration
# Copy this file to .env and fill in your values

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=proxypool
DB_PASS=your_secure_password_here
DB_NAME=proxypool

# Connection Pooling
# pool_size: Number of permanent connections (default: 20)
# max_overflow: Extra connections allowed when pool is full (default: 30)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Legacy SQLite (used for migration)
SQLITE_DB_PATH=proxies.db

# Flask Secret (for dashboard session security)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_random_string
