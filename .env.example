# Copy to .env and replace every change-me value before regular use.

# Database
DB_TYPE=sqlite
SQLITE_DB_PATH=proxies.db
# Optional explicit SQLAlchemy URL; when set, it overrides DB_TYPE/SQLITE_DB_PATH.
# DATABASE_URL=sqlite:////absolute/path/to/proxies.sqlite
# Optional target used only by migrate.py; never required for normal startup.
# MIGRATION_TARGET_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/proxypool

# MySQL (used only when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=proxypool
DB_PASS=change-me
DB_NAME=proxypool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Session/JWT secrets
# Generate each value with:
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-random-session-secret
JWT_SECRET=change-me-random-jwt-secret
JWT_EXPIRY_HOURS=24


# Local dashboard listener
# Loopback is the safe default for the Flask development server.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5003
# Set true only for an intentionally trusted local network.
DASHBOARD_ALLOW_PUBLIC=false

# Browser security
# Set true only when the dashboard is served over HTTPS.
SESSION_COOKIE_SECURE=false
MAX_REQUEST_BYTES=4194304
TOKEN_CLEANUP_INTERVAL_SECONDS=900

# Optional legacy environment-backed admin.
# Prefer a database administrator created with scripts/create_admin.py.
# No default account/password exists when this variable is omitted.
# DASHBOARD_PASSWORD=change-me-strong-password
